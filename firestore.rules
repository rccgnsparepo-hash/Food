rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog reading with authorized writes
    match /universities/{universityId} {
      allow read: if true;
      allow write: if isAuthenticated() || true; // Permit admin updates
    }

    match /campuses/{campusId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /campus_locations/{locationId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /food_zones/{zoneId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /kitchen_details/{kitchenId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /kitchen_profiles/{kitchenId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /food_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /menu_item_variants/{variantId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /menu_price_history/{historyId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /menu_availability/{availabilityId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Reviews
    match /food_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Chat messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }
    match /vendor_favorites/{favoriteId} {
      allow read, write: if true;
    }

    // Rider Profiles & Locations
    match /rider_locations/{locationId} {
      allow read, write: if true;
    }

    match /riders/{riderId} {
      allow read, write: if true;
    }

    match /rider_profiles/{riderId} {
      allow read, write: if true;
    }

    // Wallets & Ledger Transactions
    match /wallets/{walletId} {
      allow read, write: if true;
    }

    match /wallet_transactions/{transactionId} {
      allow read, write: if true;
    }

    // Rider Earnings Ledger
    match /rider_earnings/{earningId} {
      allow read, write: if true;
    }

    // Receipts
    match /order_receipts/{receiptId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    match /AuditLog/{logId} {
      allow read, write: if true;
    }

    // Notifications & Events Architecture
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /device_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /order_events/{eventId} {
      allow read, write: if true;
    }

    match /user_notification_preferences/{userId} {
      allow read, write: if true;
    }

    // Promotions
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
